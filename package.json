{
  "name": "@1zuku/jui",
  "version": "0.1.1",
  "description": "Tactile 2D Pixel game UI component library and CLI for retro web games and RPG interfaces",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jui": "bin/jui.mjs",
    "@1zuku/jui": "bin/jui.mjs"
  },
  "files": [
    "bin",
    "lib/registry.json",
    "components",
    "lib"
  ],
  "keywords": [
    "react",
    "components",
    "pixel",
    "retro",
    "saas",
    "ui",
    "tailwind",
    "shadcn",
    "design-system",
    "cli"
  ],
  "author": "Asif Shah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notAshif/jui.git"
  },
  "homepage": "https://github.com/notAshif/jui#readme",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-registry.mjs && next build",
    "build:registry": "node scripts/build-registry.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pixelarticons": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
